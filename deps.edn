{:paths ["src/clj"]
 :deps
 {com.github.seancorfield/honeysql {:mvn/version "2.4.980"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.847"}
  com.grammarly/omniconf {:mvn/version "0.4.3"}
  integrant/integrant {:mvn/version "0.8.0"}
  metosin/jsonista {:mvn/version "0.3.7"}
  org.apache.lucene/lucene-core {:mvn/version "9.11.1"}
  org.apache.lucene/lucene-analysis-common {:mvn/version "9.11.1"}
  org.apache.lucene/lucene-queryparser {:mvn/version "9.11.1"}
  org.clojure/clojure {:mvn/version "1.12.0"}
  org.clojure/math.combinatorics {:mvn/version "0.1.6"}
  org.postgresql/postgresql {:mvn/version "42.1.4"}}
 :aliases
 {:dev/repl {:extra-deps
             {nrepl/nrepl       {:mvn/version "RELEASE"}
              cider/cider-nrepl {:mvn/version "RELEASE"}}
             :extra-paths ["test/clj"]
             :main-opts ["-m"
                         "nrepl.cmdline"
                         "--middleware"
                         "[cider.nrepl/cider-middleware]"
                         "-i"]}
  :dev/test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.80.1274"}}
             :exec-fn kaocha.runner/exec-fn
             :jvm-opts ["-XX:-OmitStackTraceInFastThrow"]
             :exec-args {}
             :extra-paths ["test/clj"]}}}
